# Deliberum local development example
# Copy to .env only for local development. Never commit .env.

# Current local Web UI default. The Web app reads this Vite variable when set.
VITE_DELIBERUM_DAEMON_URL=http://127.0.0.1:3877

# Current daemon defaults are compiled into apps/daemon. The current daemon
# entrypoint does not load host/port from .env.
# DELIBERUM_HOST=127.0.0.1
# DELIBERUM_PORT=3877

# Optional Stage 22A local/pre-production OpenAI-compatible daemon profile.
# Disabled by default. Enable only for local provider-backed sealed divergence
# participant execution. Stage 22B provider-backed extraction has a separate
# opt-in flag below. Never commit real keys.
# DELIBERUM_ENABLE_OPENAI_COMPATIBLE_PROFILE=true
# DELIBERUM_ENABLE_OPENAI_COMPATIBLE_EXTRACTION=true
# DELIBERUM_OPENAI_EXTRACTION_PROVIDER_CONFIG_ID=openai-main
# DELIBERUM_OPENAI_API_KEY=
# DELIBERUM_OPENAI_BASE_URL=https://api.openai.com
# DELIBERUM_OPENAI_ENDPOINT_PATH=/v1/chat/completions
# DELIBERUM_OPENAI_MODEL=
# DELIBERUM_OPENAI_TIMEOUT_MS=30000
# Optional non-secret request compatibility options for local provider smoke.
# Omit these to keep the default request body as model + messages only.
# DELIBERUM_OPENAI_TOKEN_PARAMETER=max_completion_tokens
# DELIBERUM_OPENAI_MAX_COMPLETION_TOKENS=1024
# DELIBERUM_OPENAI_TEMPERATURE=1
# DELIBERUM_OPENAI_TOP_P=0.95
# DELIBERUM_OPENAI_STREAM=false
# DELIBERUM_OPENAI_FREQUENCY_PENALTY=0
# DELIBERUM_OPENAI_PRESENCE_PENALTY=0
# DELIBERUM_OPENAI_THINKING=disabled

# Deferred examples. The current implementation does not load SQLite storage
# or resource exposure policy from .env.
# DELIBERUM_DATABASE_URL=file:./.deliberum/deliberum.sqlite
# DELIBERUM_RESOURCE_EXPOSURE=localhost
# DELIBERUM_RESOURCE_TTL_SECONDS=900

# Do not place real API keys, private tokens, local file paths, or provider
# credentials in committed files.
