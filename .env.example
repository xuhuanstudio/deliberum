# Deliberum local development example
# Copy to .env only for local development. Never commit .env.

# Current local Web UI default. The Web app reads this Vite variable when set.
VITE_DELIBERUM_DAEMON_URL=http://127.0.0.1:3877

# Current daemon defaults are compiled into apps/daemon. The current daemon
# entrypoint does not load host/port from .env.
# DELIBERUM_HOST=127.0.0.1
# DELIBERUM_PORT=3877

# Deferred examples. The current implementation does not load provider
# credentials, SQLite storage, or resource exposure policy from .env.
# DELIBERUM_DATABASE_URL=file:./.deliberum/deliberum.sqlite
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DELIBERUM_RESOURCE_EXPOSURE=localhost
# DELIBERUM_RESOURCE_TTL_SECONDS=900

# Do not place real API keys, private tokens, local file paths, or provider
# credentials in committed files.
