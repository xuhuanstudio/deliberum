# Deliberum local development example.
# Copy to .env for local Web/Vite development. Daemon and CLI entrypoints read
# process.env; export those variables in the shell or pass them inline when
# starting the process. Never commit .env.

# Current local Web UI default. The Web app reads this Vite variable when set.
# The Web dev script uses 127.0.0.1:5173 with strictPort to match daemon CORS.
VITE_DELIBERUM_DAEMON_URL=http://127.0.0.1:3877

# Current daemon defaults are compiled into apps/daemon. The current daemon
# entrypoint does not load host/port from .env.
# DELIBERUM_HOST=127.0.0.1
# DELIBERUM_PORT=3877

# Recommended local/pre-production daemon SQLite persistence. This stores daemon
# event ledger rows, run metadata, explicitly registered resource broker
# metadata/content, and resource access grant state in one local SQLite database
# with local connection-level writer serialization. It does not persist WebGET
# sessions, authentication state, provider secrets, or production multi-user
# coordination.
# DELIBERUM_DAEMON_SQLITE_PATH=.deliberum/deliberum.sqlite

# Optional local daemon JSON persistence fallback. Set both paths together when
# local run workspace state must survive daemon restarts without SQLite.
# DELIBERUM_DAEMON_EVENT_STORE_PATH=.deliberum/daemon-events.json
# DELIBERUM_DAEMON_RUN_STORE_PATH=.deliberum/daemon-runs.json

# Optional local/pre-production daemon control-plane bearer authentication.
# When set, daemon control endpoints require Authorization: Bearer <token>.
# /health, WebGET bearer-token endpoints, and GET /resource-access/:accessId use
# their own health/token semantics and are not blocked by this control token.
# DELIBERUM_DAEMON_AUTH_TOKEN=
# Optional local Web dev token forwarding. This value is visible to the browser;
# use only for trusted local/pre-production Web shells, not public multi-user UI.
# VITE_DELIBERUM_DAEMON_AUTH_TOKEN=

# Optional deterministic local preset profile for local development and tests.
# Disabled by default; not production behavior.
# DELIBERUM_ENABLE_LOCAL_PRESET=true

# Optional local/pre-production OpenAI-compatible daemon profile. The profile
# gate is required before component gates matter. Use literal true; other values
# leave the profile disabled. Provider secrets stay in process.env; never commit
# real keys.
# DELIBERUM_ENABLE_OPENAI_COMPATIBLE_PROFILE=true
# DELIBERUM_ENABLE_OPENAI_COMPATIBLE_EXTRACTION=true
# DELIBERUM_ENABLE_OPENAI_COMPATIBLE_REVIEW=true
# DELIBERUM_ENABLE_OPENAI_COMPATIBLE_FINALIZATION=true
# DELIBERUM_OPENAI_EXTRACTION_PROVIDER_CONFIG_ID=openai-main
# DELIBERUM_OPENAI_EXTRACTION_RESPONSE_FORMAT=json_object
# DELIBERUM_OPENAI_REVIEW_PROVIDER_CONFIG_ID=openai-main
# DELIBERUM_OPENAI_REVIEW_RESPONSE_FORMAT=json_object
# DELIBERUM_OPENAI_FINAL_CANDIDATE_PROVIDER_CONFIG_ID=openai-main
# DELIBERUM_OPENAI_FINAL_CANDIDATE_RESPONSE_FORMAT=json_object
# DELIBERUM_OPENAI_FINAL_AUDIT_PROVIDER_CONFIG_ID=openai-main
# DELIBERUM_OPENAI_FINAL_AUDIT_RESPONSE_FORMAT=json_object
# DELIBERUM_OPENAI_API_KEY=
# DELIBERUM_OPENAI_BASE_URL=https://api.openai.com
# DELIBERUM_OPENAI_ENDPOINT_PATH=/v1/chat/completions
# DELIBERUM_OPENAI_MODEL=
# DELIBERUM_OPENAI_TIMEOUT_MS=30000
# Optional non-secret request compatibility options for local provider smoke.
# Omit these to keep the default request body as model + messages only.
# Valid token parameter values: none, max_tokens, max_completion_tokens.
# DELIBERUM_OPENAI_TOKEN_PARAMETER=max_completion_tokens
# DELIBERUM_OPENAI_MAX_COMPLETION_TOKENS=1024
# DELIBERUM_OPENAI_TEMPERATURE=0
# DELIBERUM_OPENAI_TOP_P=0.95
# Streaming output is not implemented; only false is accepted.
# DELIBERUM_OPENAI_STREAM=false
# DELIBERUM_OPENAI_FREQUENCY_PENALTY=0
# DELIBERUM_OPENAI_PRESENCE_PENALTY=0
# Thinking compatibility currently accepts only disabled.
# DELIBERUM_OPENAI_THINKING=disabled

# Optional local/pre-production HTTP-template participant daemon profile for
# sealed divergence. The profile registers only a participant adapter; it does
# not install extraction/review/finalization components or provider setup UX.
# Provider secrets stay in process.env and are referenced by run-plan
# apiKeyEnvVar; never commit real keys.
# DELIBERUM_ENABLE_HTTP_TEMPLATE_PROFILE=true
# DELIBERUM_HTTP_TEMPLATE_API_KEY=
# DELIBERUM_HTTP_TEMPLATE_HEADERS_JSON={"Authorization":"Bearer {{runtime.apiKey}}"}
# DELIBERUM_HTTP_TEMPLATE_BODY={"model":"{{runtime.modelId}}","payload":{{input.payloadJson}}}
# DELIBERUM_HTTP_TEMPLATE_RESPONSE_FORMAT=json
# DELIBERUM_HTTP_TEMPLATE_RESPONSE_PAYLOAD_PATH=output
# DELIBERUM_HTTP_TEMPLATE_RESPONSE_MODEL_ID_PATH=model
# Optional non-secret request template overrides. When omitted, baseUrl and
# endpointPath come from the run-plan provider config through runtime
# placeholders.
# DELIBERUM_HTTP_TEMPLATE_URL=
# DELIBERUM_HTTP_TEMPLATE_BASE_URL={{runtime.baseUrl}}
# DELIBERUM_HTTP_TEMPLATE_ENDPOINT_PATH={{runtime.endpointPath}}
# DELIBERUM_HTTP_TEMPLATE_METHOD=POST
# DELIBERUM_HTTP_TEMPLATE_TIMEOUT_MS=30000

# Optional local/pre-production MCP tool participant daemon profile for sealed
# divergence. The profile calls one configured MCP-compatible JSON-RPC tool
# endpoint and does not start MCP servers, expose arbitrary tools, or provide a
# production sandbox.
# DELIBERUM_ENABLE_MCP_TOOL_PROFILE=true
# DELIBERUM_MCP_TOOL_URL=http://127.0.0.1:8787/mcp
# DELIBERUM_MCP_TOOL_NAME=deliberum.reflect
# DELIBERUM_MCP_TOOL_AUTH_TOKEN=
# DELIBERUM_MCP_TOOL_TIMEOUT_MS=30000
# Non-local MCP endpoints require explicit opt-in and must use HTTPS.
# DELIBERUM_MCP_TOOL_ALLOW_REMOTE=false
# DELIBERUM_MCP_TOOL_VERIFY_LIST=true
# Optional request-shaping policy for the configured tools/call request.
# DELIBERUM_MCP_TOOL_MAX_ARGUMENT_BYTES=8192
# DELIBERUM_MCP_TOOL_ALLOWED_ARGUMENT_KEYS=instructions,payload,context
# DELIBERUM_MCP_TOOL_INCLUDE_CONTEXT=true

# Optional daemon resource access grants for allowed URL and hosted in-memory
# content deliveries. The default base URL is the daemon's current host/port.
# Env-configured non-local base URLs require explicit opt-in, and public base
# URLs must use HTTPS.
# DELIBERUM_RESOURCE_ACCESS_BASE_URL=http://127.0.0.1:3877
# DELIBERUM_RESOURCE_ACCESS_ALLOW_REMOTE=false
# DELIBERUM_RESOURCE_ACCESS_TTL_MS=300000

# Deferred examples. The current implementation does not load production auth,
# public resource exposure policy, or remote deployment settings from env.
# DELIBERUM_RESOURCE_EXPOSURE=localhost

# Do not place real API keys, private tokens, machine-specific local file paths,
# or provider credentials in committed files.
